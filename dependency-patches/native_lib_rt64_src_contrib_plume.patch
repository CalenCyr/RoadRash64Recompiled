 namespace plume {
+    static std::atomic<D3D12PresentOutcomeCallback> presentOutcomeCallback{nullptr};
+
+    void setD3D12PresentOutcomeCallback(D3D12PresentOutcomeCallback callback) noexcept {
+        presentOutcomeCallback.store(callback, std::memory_order_release);
+    }
+
+    static void recordPresentOutcome(D3D12PresentOutcome outcome, uint32_t resultCode) noexcept {
+        if (const auto callback = presentOutcomeCallback.load(std::memory_order_acquire)) {
+            callback(outcome, resultCode);
+        }
+    }
