     bool D3D12SwapChain::present(uint32_t textureIndex, RenderCommandSemaphore **waitSemaphores, uint32_t waitSemaphoreCount) {
-        // If using present wait, we prefer using a SyncInterval of 0 even when Vsync is enabled. Tearing won't happen if DXGI_PRESENT_ALLOW_TEARING is not specified.
         const bool tearingAllowed = (swapChainFlags & DXGI_SWAP_CHAIN_FLAG_ALLOW_TEARING) != 0U;
-        UINT syncInterval = (vsyncEnabled && !desc.enablePresentWait) ? 1 : 0;
+        UINT syncInterval = vsyncEnabled ? 1 : 0;
         UINT flags = (!vsyncEnabled && tearingAllowed) ? DXGI_PRESENT_ALLOW_TEARING : 0;
+
+        // A borderless-fullscreen flip chain can stop draining while another
+        // window owns the foreground. Submitting into that stalled chain can
+        // block indefinitely and back up both RT64 queues. Keep rendering and
+        // emulation alive, but defer scan-out until the game regains focus.
+        if (GetForegroundWindow() != desc.renderWindow) {
+            presentationDeferredForFocus = true;
+            recordPresentOutcome(D3D12PresentOutcome::FocusDeferred, 0);
+            return true;
+        }
+
+        // Software-paced, tearing-enabled output must never acquire a second
+        // implicit pacing gate inside Present(). If the compositor queue is
+        // momentarily full, retain the current back buffer for the next frame
+        // instead of blocking for an entire refresh interval.
+        if (!vsyncEnabled && tearingAllowed) {
+            flags |= DXGI_PRESENT_DO_NOT_WAIT;
+        }
+
         HRESULT res = d3d->Present(syncInterval, flags);
+        presentationDeferredForFocus = false;
+        if (res == DXGI_ERROR_WAS_STILL_DRAWING) {
+            recordPresentOutcome(D3D12PresentOutcome::Busy, static_cast<uint32_t>(res));
+            return true;
+        }
+        if (res == DXGI_STATUS_OCCLUDED) {
+            recordPresentOutcome(D3D12PresentOutcome::Occluded, static_cast<uint32_t>(res));
+            return true;
+        }
+
+        recordPresentOutcome(SUCCEEDED(res) ? D3D12PresentOutcome::Accepted :
+            D3D12PresentOutcome::Error, static_cast<uint32_t>(res));
         return SUCCEEDED(res);
     }
 
     void D3D12SwapChain::wait() {
         assert(desc.enablePresentWait && "Present wait should've been explicitly enabled during swap chain creation before using the wait function.");
 
+        // Do not consume the auto-reset frame-latency signal while presentation
+        // is intentionally deferred. On focus return the first Present must be
+        // allowed through without waiting so it can prime the signal again.
+        if ((GetForegroundWindow() != desc.renderWindow) || presentationDeferredForFocus) {
+            return;
+        }
+
         if (waitableObject != NULL) {
             WaitForSingleObject(waitableObject, INFINITE);
         }
