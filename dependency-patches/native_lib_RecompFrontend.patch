+static void stop_physical_rumble_locked() {
+    // Always send a zeroed command at a gameplay/focus boundary. The normal
+    // output commands self-expire as a safety net, but this keeps pause and
+    // Alt-Tab stops immediate when the device is still reachable.
+    std::lock_guard lock{ InputState.controllers_mutex };
+    for (SDL_GameController* controller : InputState.detected_controllers) {
+        if (controller == nullptr) {
+            continue;
+        }
+
+        SDL_Joystick* joystick = SDL_GameControllerGetJoystick(controller);
+        const SDL_JoystickID joystick_id = SDL_JoystickInstanceID(joystick);
+        SDL_JoystickRumble(joystick, 0, 0, 0);
+
+        const auto state_it = InputState.controller_states.find(joystick_id);
+        if (state_it != InputState.controller_states.end()) {
+            state_it->second.last_rumble_low = 0;
+            state_it->second.last_rumble_high = 0;
+            state_it->second.last_rumble_command_ms = SDL_GetTicks64();
+            state_it->second.rumble_output_active = false;
+        }
+    }
+}
+
+void recompinput::suspend_all_rumble() {
+    std::lock_guard rumble_lock{ InputState.rumble_mutex };
+    for (size_t i = 0; i < InputState.rumble_active.size(); ++i) {
+        // Preserve the Rumble Pak's authored on/off state across a pause or
+        // focus loss. Road feedback and impact pulses are transient and are
+        // rebuilt from live gameplay input after resume.
+        InputState.road_rumble[i].store(0.0f, std::memory_order_relaxed);
+        InputState.rumble_pulse[i].store(0.0f, std::memory_order_relaxed);
+        InputState.cur_rumble[i] = 0.0f;
+    }
+    stop_physical_rumble_locked();
+}
+
+void recompinput::stop_all_rumble() {
+    std::lock_guard rumble_lock{ InputState.rumble_mutex };
+    for (size_t i = 0; i < InputState.rumble_active.size(); ++i) {
+        InputState.rumble_active[i].store(false, std::memory_order_relaxed);
+        InputState.road_rumble[i].store(0.0f, std::memory_order_relaxed);
+        InputState.rumble_pulse[i].store(0.0f, std::memory_order_relaxed);
+        InputState.cur_rumble[i] = 0.0f;
+    }
+    stop_physical_rumble_locked();
